##################################### 1) Estimated gamma distribution of onset-to-severe using severe cases in this study
s <- 1.3936628 # shape
r <- 0.1892671 # rate

Gamma_mean <- s/r
Gamma_median <- qgamma(0.5, shape = s, rate = r)

##################################### 2) Lognormal distribution of onset-to-diagnosis from Shim et al
mu <- 3.12
sigma <- 3.22

Shim_lnorm <- data.frame(estimate=c(log(mu)-(log(1+(sigma/mu)^2))/2,sqrt(log(1+(sigma/mu)^2))))

Shim_lnorm_mean <- exp(Shim_lnorm$estimate[1] + (1/2)*Shim_lnorm$estimate[2]^2)
Shim_lnorm_median <- qlnorm(0.5, meanlog = Shim_lnorm$estimate[1], sdlog = Shim_lnorm$estimate[2])

shift <- 2

fn <- "Fig4B.pdf"
pdf(fn,width=24,height=14)
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
xlabel <- "Time since symptom onset (days)"
ylabel <- "Density"
pnl_4B <- ggplot() +
  
  stat_function(fun = function(x) dgamma(x, shape = s, rate = r), 
                linewidth = 2.5,
                color = "black",
                n=5000) +
  stat_function(fun = function(x) dgamma(x, shape = s, rate = r), 
                geom = "area",
                fill = "black",
                alpha = 0.2,
                n=5000) +
  geom_vline(xintercept = Gamma_mean, linetype = "dashed", linewidth = 3, color = "black") +
  
  stat_function(fun = function(x) ifelse(x <= shift, 0, dlnorm(x - shift, meanlog = Shim_lnorm$estimate[1], sdlog = Shim_lnorm$estimate[2])), 
                linewidth = 2.5,
                color = "#002060",
                n=5000) +
  stat_function(fun = function(x) ifelse(x <= shift, 0, dlnorm(x - shift, meanlog = Shim_lnorm$estimate[1], sdlog = Shim_lnorm$estimate[2])), 
                geom = "area",
                fill = "#002060",
                alpha = 0.2,
                n=5000) +
  geom_vline(xintercept = Shim_lnorm_mean + shift, linetype = "dashed", linewidth = 3, color = "#002060") +
  
  scale_x_continuous(limits=c(0,14), breaks=seq(0,14,by=2)) +
  scale_y_continuous(limits=c(0,0.4), breaks=seq(0,0.4,by=0.1)) +
  
  xlab(xlabel) +
  ylab(ylabel) +
  theme(plot.title = element_text(colour = "black", size=36),
        axis.text.x = element_text(colour = "black"),
        axis.text.y = element_text(colour = "black"),
        axis.ticks.x = element_blank(),
        axis.ticks.y = element_line(colour = "black"),
        axis.line = element_line(colour = "black"),
        panel.grid.major.x = element_blank(),
        panel.grid.major.y = element_blank(),
        panel.grid.minor = element_blank(),
        panel.background = element_blank(),
        legend.position='none',
        axis.title.x = element_text(colour = "black"),
        axis.title.y = element_text(colour = "black"))
print( pnl_4B )
dev.off()




