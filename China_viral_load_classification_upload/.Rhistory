fig4a_lgb_diag <- ggplot(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("Accuracy", "AUROC_value", "Sensitivity")), aes(x = variable, y = estimate, color = Metrics)) +
geom_col(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("Sensitivity")), aes(x = variable, y = estimate, fill = Metrics), alpha = 0.8) +
geom_errorbar(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("Sensitivity")), aes(ymin = lower, ymax = upper), linewidth = 1.2, width = 0.3,
color = "black") +
geom_line(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("AUROC_value")), aes(x = variable, y = estimate, color = Metrics), linewidth = rel(2), linetype = "solid") +
geom_point(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("AUROC_value")), aes(x = variable, y = estimate, color = Metrics), size = rel(4)) +
geom_line(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("Accuracy")), aes(x = variable, y = estimate, color = Metrics), linewidth = rel(2), linetype = "dashed") +
geom_point(data = lgb_perf_viz_df_all2 %>% filter(Metrics %in% c("Accuracy")), aes(x = variable, y = estimate, color = Metrics), size = rel(4)) +
xlab("Day since diagnosis (days)") +
ylab("Metrics (%)") +
scale_fill_manual(name = "", values = c(Sensitivity = "#0072B2")) +
scale_color_manual(name = "", values = c(AUROC_value = "#FFC001", Accuracy = "#FA766E")) +
guides(
fill  = guide_legend(order = 1, override.aes = list(alpha = 0.6)),
color = guide_legend(order = 2, override.aes = list(linetype = 1, shape = 16))
) +
scale_x_continuous(limits = c(-0.5, 10.5), breaks = seq(0, 10, 1)) +
coord_cartesian(ylim = c(88, 98)) +
theme(axis.text = element_text(color = "black"),
axis.text.x = element_text(vjust = 0.5, hjust = 0.5, face = "bold", size = rel(4)),
axis.text.y = element_text(face = "bold", size = rel(4)),
axis.line = element_line(color = "black"),
strip.text.x = element_text(vjust = 0.5, face = "bold"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position = "none",
legend.box = "horizontal",
legend.text = element_text(size = rel(2)),
axis.title.x = element_text(size = rel(4)),
axis.title.y = element_text(size = rel(4))
)
fig4a_lgb_diag
SF7A_Sen <- subset(lgb_perf_viz_df_all2, Metrics == "Sensitivity")
SF7A_Acc <- subset(lgb_perf_viz_df_all2, Metrics == "Accuracy")
SF7A_AUC <- subset(lgb_perf_viz_df_all2, Metrics == "AUROC_value")
lb_A <- 85
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
fig4a_lgb_diag <- ggplot() +
geom_bar(data = SF7A_Sen, aes(x = variable, y = pmax(estimate - lb_A, 0)), fill = "#348EC2", position = "dodge", stat = "identity", width = 0.6) +
geom_errorbar(data = SF7A_Sen, aes(x = variable, ymin = pmax(lower - lb_A, 0), ymax = pmax(upper - lb_A, 0)), width = 0.3, position = position_dodge(0.6), linewidth = 1.0) +
geom_point(data = SF7A_Acc, aes(x = variable, y = pmax(estimate - lb_A, 0)), color = "#FA766E", size = 7) +
geom_line(data = SF7A_Acc, aes(x = variable, y = pmax(estimate - lb_A, 0)), color = "#FA766E", linewidth = 2, linetype = "dashed") +
geom_point(data = SF7A_AUC, aes(x = variable, y = pmax(estimate - lb_A, 0)), color = "#FFC001", size = 7) +
geom_line(data = SF7A_AUC, aes(x = variable, y = pmax(estimate - lb_A, 0)), color = "#FFC001", linewidth = 2, linetype = "solid") +
scale_x_continuous(breaks=seq(0, 100 - lb_A, by = 1)) +
scale_y_continuous(
limits = c(0, 100 - lb_A),
breaks  = seq(0, 100 - lb_A, by = 5),
labels  = function(b) sprintf("%d", b + lb_A)) +
xlab("Time since diagnosis (days)") +
ylab("Metrics (%)") +
theme(plot.title = element_text(colour = "black", size=36),
axis.text.x = element_text(colour = "black"),
axis.text.y = element_text(colour = "black"),
axis.ticks.x = element_blank(),
axis.ticks.y = element_line(colour = "black"),
axis.line = element_line(colour = "black"),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position='none',
axis.title.x = element_text(colour = "black"),
axis.title.y = element_text(colour = "black"))
fig4a_lgb_diag
SF7B_Sen <- subset(model_perf_comp_lgb2, Metrics == "Sensitivity")
SF7B_Acc <- subset(model_perf_comp_lgb2, Metrics == "Accuracy")
SF7B_AUC <- subset(model_perf_comp_lgb2, Metrics == "AUROC")
SF7B_Sen$group <- c("0","1","3","2")
SF7B_Acc$group <- c("0","1","3","2")
SF7B_AUC$group <- c("0","1","3","2")
lb_C <- 60
sig_df <- data.frame(
group1 = c("0", "1", "2", "1", "0", "0"),
group2 = c("1", "2", "3", "3", "2", "3"),
y.position = c(14 + 30, 16 + 30, 18 + 30, 20 + 30, 22 + 30, 24 + 30),
label = c("****", "****", "", "****", "", "")
)
text_df_AUC <- SF7B_Sen %>%
dplyr::transmute(group, y_top = pmin(pmax(upper - lb_C, 0), 50)) %>%
dplyr::left_join(
SF7B_AUC %>% dplyr::select(group, estimate),
by = "group"
) %>%
dplyr::mutate(
label = sprintf("AUROC = %.1f%%", estimate),
y = y_top + 3.3
)
text_df_Acc <- SF7B_Sen %>%
dplyr::transmute(group, y_top = pmin(pmax(upper - lb_C, 0), 50)) %>%
dplyr::left_join(
SF7B_Acc %>% dplyr::select(group, estimate),
by = "group"
) %>%
dplyr::mutate(
label = sprintf("Accuracy = %.1f%%", estimate),
y = y_top + 1.3
)
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
xlabel <- ""
ylabel <- "Sensitivity (%)"
pnl_sf7b <- ggplot() +
geom_bar(data = SF7B_Sen, aes(x = group, y = pmax(estimate - lb_C, 0), fill = group), position = "dodge", stat = "identity", width = 0.4) +
scale_fill_manual(values=c("#D86ECC","#348EC2","#0070C0","#002060")) +
geom_errorbar(data = SF7B_Sen, aes(x = group, ymin = pmax(lower - lb_C, 0), ymax = pmax(upper - lb_C, 0)), width = 0.2, position = position_dodge(0.4), size = 1.0) +
stat_pvalue_manual(
sig_df,
label = "label",
xmin  = "group1",
xmax  = "group2",
y.position  = "y.position",
tip.length  = 0.01,
bracket.size = 1,
size = 10
) +
scale_x_discrete(labels = c("Onset only", "Diagnosis only", "Diagnosis + Day 1", "Diagnosis + Day 2"), limits = c("0", "1", "2", "3")) +
scale_y_continuous(
limits = c(0, 100 - lb_C + 15),
breaks  = seq(0, 100 - lb_C, by = 10),
labels  = function(b) sprintf("%d", b + lb_C)) +
geom_text(
data = text_df_AUC,
aes(x = group, y = y, label = label),
position = position_dodge(0.6), vjust = 0, size = 10, color = "#FFC001"
) +
geom_text(
data = text_df_Acc,
aes(x = group, y = y, label = label),
position = position_dodge(0.6), vjust = 0, size = 10, color = "#FA766E"
) +
xlab(xlabel) +
ylab(ylabel) +
theme(plot.title = element_text(colour = "black", size=36),
axis.text.x = element_text(colour = "black"),
axis.text.y = element_text(colour = "black"),
axis.ticks.x = element_blank(),
axis.ticks.y = element_line(colour = "black"),
axis.line = element_line(colour = "black"),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position='none',
axis.title.x = element_text(colour = "black"),
axis.title.y = element_text(colour = "black"))
pnl_sf7b
SF7C_Sen <- subset(agg_df2_lgb, Metrics == "Sensitivity")
SF7C_Acc <- subset(agg_df2_lgb, Metrics == "Accuracy")
SF7C_AUC <- subset(agg_df2_lgb, Metrics == "AUROC")
SF7C_Sen <- SF7C_Sen[SF7C_Sen$model_sce != "Onset + day 2",]
SF7C_Sen$group <- rep(c("0", "1", "3", "2"), times = 6)
lb_C <- 60
lb_D <- 60
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
fig4d_lgb_diag <- ggplot() +
geom_bar(data = SF7C_Sen, aes(x = factor(scenario), y = pmax(estimate - lb_D, 0), fill = factor(model_sce)), position = "dodge", stat = "identity", width = 0.6) +
scale_fill_manual(values = c("#D86ECC", "#348EC2", "#0070C0", "#002060")) +
geom_errorbar(data = SF7C_Sen, aes(x = factor(scenario), ymin = pmax(lower - lb_D, 0), ymax = pmax(upper - lb_D, 0), group = factor(model_sce)), width = 0.2, position = position_dodge(0.6), size = 1.0) +
scale_x_discrete(labels = function(x) {
x <- gsub(">=", "≥", x)
x <- sub("\\s+(?=(?:≥|\\d))", "\n", x, perl = TRUE)
x
}) +
scale_y_continuous(
limits = c(0, 100 - lb_D + 15),
breaks  = seq(0, 100 - lb_D, by = 10),
labels  = function(b) sprintf("%d", b + lb_C)) +
xlab("") +
ylab("Sensitivity (%)") +
theme(plot.title = element_text(colour = "black", size = 36),
axis.text.x = element_text(colour = "black"),
axis.text.y = element_text(colour = "black"),
axis.ticks.x = element_blank(),
axis.ticks.y = element_line(colour = "black"),
axis.line = element_line(colour = "black"),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position ='none',
axis.title.x = element_text(colour = "black"),
axis.title.y = element_text(colour = "black"))
fig4d_lgb_diag
fig4d_lgb_diag
