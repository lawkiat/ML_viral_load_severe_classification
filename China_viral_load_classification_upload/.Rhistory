)
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
xlabel <- ""
ylabel <- "Sensitivity (%)"
pnl_sf7b <- ggplot() +
geom_bar(data = SF7B_Sen, aes(x = group, y = pmax(estimate - lb_C, 0), fill = group), position = "dodge", stat = "identity", width = 0.4) +
scale_fill_manual(values=c("#D86ECC","#348EC2","#0070C0","#002060")) +
geom_errorbar(data = SF7B_Sen, aes(x = group, ymin = pmax(lower - lb_C, 0), ymax = pmax(upper - lb_C, 0)), width = 0.2, position = position_dodge(0.4), size = 1.0) +
stat_pvalue_manual(
sig_df,
label = "label",
xmin  = "group1",
xmax  = "group2",
y.position  = "y.position",
tip.length  = 0.01,
bracket.size = 1,
size = 10
) +
scale_x_discrete(labels = c("Onset only", "Diagnosis only", "Diagnosis + Day 1", "Diagnosis + Day 2"), limits = c("0", "1", "2", "3")) +
scale_y_continuous(
limits = c(0, 100 - lb_C + 15),
breaks  = seq(0, 100 - lb_C, by = 10),
labels  = function(b) sprintf("%d", b + lb_C)) +
geom_text(
data = text_df_AUC,
aes(x = group, y = y, label = label),
position = position_dodge(0.6), vjust = 0, size = 10, color = "#FFC001"
) +
geom_text(
data = text_df_Acc,
aes(x = group, y = y, label = label),
position = position_dodge(0.6), vjust = 0, size = 10, color = "#FA766E"
) +
xlab(xlabel) +
ylab(ylabel) +
theme(plot.title = element_text(colour = "black", size=36),
axis.text.x = element_text(colour = "black"),
axis.text.y = element_text(colour = "black"),
axis.ticks.x = element_blank(),
axis.ticks.y = element_line(colour = "black"),
axis.line = element_line(colour = "black"),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position='none',
axis.title.x = element_text(colour = "black"),
axis.title.y = element_text(colour = "black"))
pnl_sf7b
SF7C_Sen <- subset(agg_df2_lgb, Metrics == "Sensitivity")
SF7C_Acc <- subset(agg_df2_lgb, Metrics == "Accuracy")
SF7C_AUC <- subset(agg_df2_lgb, Metrics == "AUROC")
SF7C_Sen <- SF7C_Sen[SF7C_Sen$model_sce != "Onset + day 2",]
SF7C_Sen$group <- rep(c("0", "1", "3", "2"), times = 6)
lb_C <- 60
lb_D <- 60
theme_set(theme_classic(base_size = 50, base_family = "Helvetica"))
fig4d_lgb_diag <- ggplot() +
geom_bar(data = SF7C_Sen, aes(x = factor(scenario), y = pmax(estimate - lb_D, 0), fill = factor(model_sce)), position = "dodge", stat = "identity", width = 0.6) +
scale_fill_manual(values = c("#D86ECC", "#348EC2", "#0070C0", "#002060")) +
geom_errorbar(data = SF7C_Sen, aes(x = factor(scenario), ymin = pmax(lower - lb_D, 0), ymax = pmax(upper - lb_D, 0), group = factor(model_sce)), width = 0.2, position = position_dodge(0.6), size = 1.0) +
scale_x_discrete(labels = function(x) {
x <- gsub(">=", "≥", x)
x <- sub("\\s+(?=(?:≥|\\d))", "\n", x, perl = TRUE)
x
}) +
scale_y_continuous(
limits = c(0, 100 - lb_D + 15),
breaks  = seq(0, 100 - lb_D, by = 10),
labels  = function(b) sprintf("%d", b + lb_C)) +
xlab("") +
ylab("Sensitivity (%)") +
theme(plot.title = element_text(colour = "black", size = 36),
axis.text.x = element_text(colour = "black"),
axis.text.y = element_text(colour = "black"),
axis.ticks.x = element_blank(),
axis.ticks.y = element_line(colour = "black"),
axis.line = element_line(colour = "black"),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
legend.position ='none',
axis.title.x = element_text(colour = "black"),
axis.title.y = element_text(colour = "black"))
fig4d_lgb_diag
fig4d_lgb_diag
load("D:/class/Self Project/Covid-19/Viral Load (Fudan)/Code/China_viral_load_classification/Random_forest.RData")
library(foreach)
library(doParallel)
library(dplyr)
library(purrr)
library(randomForest)
library(pROC)
library(fastshap)
library(shapviz)
library(ggplot2)
num_cores <- parallel::detectCores() - 1
cl <- makeCluster(num_cores)
registerDoParallel(cl)
rf_vldiag_only_list <- foreach(i = 1: 100, .packages = c("dplyr", "randomForest", "pROC", "fastshap", "shapviz")) %dopar% {
split <- split_list[[i]]
train_df <- split$train %>%  select("vl_sim", "outcome")
test_df <- split$test %>% select("vl_sim", "outcome")
# Fitting the random forest model
rf_vldiag <- randomForest(outcome ~ ., data = train_df, importance = TRUE)
# Make prediction on the testing set
prediction_rf_vldiag <- predict(rf_vldiag, newdata = test_df, type = "class")
# Compute the confusion matrix
cfm_rf_vldiag <- table(prediction_rf_vldiag, test_df$outcome)
# Compute accuracy on the testing set
acc_rf_test <- sum(diag(cfm_rf_vldiag) / sum(cfm_rf_vldiag))
# Make prediction on the training set
prediction_rf_train <- predict(rf_vldiag, newdata = train_df, type = "class")
# Compute the confusion matrix
cfm_rf_vldiag_train <- table(prediction_rf_train, train_df$outcome)
# Compute accuracy on the training set
acc_rf_train <- sum(diag(cfm_rf_vldiag_train) / sum(cfm_rf_vldiag_train))
# Extract elements from the confusion matrix & compute sensitivity and specificity
TP <- cfm_rf_vldiag["Severe", "Severe"]
FP <- cfm_rf_vldiag["Severe", "Non severe"]
TN <- cfm_rf_vldiag["Non severe", "Non severe"]
FN <- cfm_rf_vldiag["Non severe", "Severe"]
sensitivity_rf_vldiag <- TP / (TP + FN)
specificity_rf_vldiag <- TN / (TN + FP)
# Compute the precision and F1-Score
prec_rf_vldiag <- TP / (TP + FP)
f1_sc_rf_vldiag <- 2 * ((prec_rf_vldiag * sensitivity_rf_vldiag) / (prec_rf_vldiag + sensitivity_rf_vldiag))
# Compute AUROC plot
pred_rf_vldiag_res <- ifelse(prediction_rf_vldiag == "Severe", 1, 0)
roc_rf_vldiag <- roc(test_df$outcome, pred_rf_vldiag_res)
auc_val_rf_vldiag <- auc(roc_rf_vldiag)
# Compute SHAP values
xvars <- colnames(train_df)[-2]
pfun_rf <- function(object, newdata) predict(object, newdata, type = "prob")[, 2]
shap_values_rf_vldiag <- fastshap::explain(rf_vldiag, X = train_df[, -2], pred_wrapper = pfun_rf)
shp_rf_vldiag <- shapviz(shap_values_rf_vldiag, X = train_df[, -which(names(train_df) == "outcome")])
# Rename variable
#shp_rf_vldiag$X <- shp_rf_vldiag$X %>% rename("Viral load at diagnosis" = "vl_sim")
#colnames(shp_rf_vldiag$S) <- c("Viral load at diagnosis")
list(model = rf_vldiag, confusion_matrix = cfm_rf_vldiag, accuracy_training = acc_rf_train, accuracy_testing = acc_rf_test,
sensitivity = sensitivity_rf_vldiag, specificity = specificity_rf_vldiag, precision = prec_rf_vldiag,
F1_score = f1_sc_rf_vldiag, AUC_value = auc_val_rf_vldiag, SHAP_values = shp_rf_vldiag, prediction = prediction_rf_vldiag)
}
